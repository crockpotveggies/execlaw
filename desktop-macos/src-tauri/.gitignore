# Tauri build artefacts.
target/
gen/
# Tauri 2 writes runtime-generated capability schemas here on first build.
gen/schemas/
# The bundled execlaw CLI binary lands under bin/ via build-mac.sh.
# Track only the README; the .gitkeep guards an otherwise-empty dir.
bin/*
!bin/.gitkeep
!bin/README.md
# Generated icon set — created from icon.png via `cargo tauri icon`.
# The source PNG is committed (icons/source.png); generated .icns
# and platform PNGs are not.
icons/icon.icns
icons/Square*Logo.png
icons/StoreLogo.png
icons/[0-9]*x[0-9]*.png
