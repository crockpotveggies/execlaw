# Tauri build artefacts.
target/
gen/
# Tauri 2 writes runtime-generated capability schemas here on first build.
gen/schemas/
# The bundled execlaw CLI binary lands under bin/ via build-mac.sh.
# Track only the README; the .gitkeep guards an otherwise-empty dir.
bin/*
!bin/.gitkeep
!bin/README.md
# Plugin ZIPs staged into Contents/Resources/plugins/ at bundle
# time. Built fresh by scripts/build-mac.sh step 4b on every
# release build, so committing them would just create drift.
resources/plugins/

# Generated icon set — rendered from the SVG sources under
# assets/ by scripts/build-mac.sh step 4. Sources (SVG, .icon
# package) live in /assets; the rendered binary artefacts are
# regenerated on every build so we don't bloat git with PNGs that
# drift from the SVG truth.
icons/icon.icns
icons/icon.png
icons/tray.png
icons/tray@2x.png
icons/dmg-background.png
icons/dmg-background@2x.png
icons/Square*Logo.png
icons/StoreLogo.png
icons/[0-9]*x[0-9]*.png
