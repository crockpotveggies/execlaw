{
  "name": "execlaw-web",
  "private": true,
  "version": "0.1.0",
  "description": "execlaw SPA — chat-first landing for the local-first agent platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bash ../scripts/dev-server.sh",
