# execlaw runner image. One container per principal group; spawned by
# the supervisor in `crates/server/src/runner_supervisor.rs`.
#
# Build:
#   docker build -f Dockerfile.runner -t execlaw/runner:dev .
#
# At runtime the supervisor passes the env vars the binary reads:
#   EXECLAW_RPC_URL=ws://host.docker.internal:3031
#   EXECLAW_GROUP_ID=<uuid>
#   EXECLAW_SPAWN_SECRET=<hex>
#   EXECLAW_INFERENCE_URL=http://127.0.0.1:8101/v1   # default; per-turn overridable
#   RUST_LOG=info,execlaw_runner=debug                # optional
#
# A named volume `execlaw-runner-<group_id>` is bind-mounted at
# /workspace; the runner can scratch there freely.
#
# Image strategy (2026-05-03): static musl build → alpine runtime.
# The runner binary is fully static; alpine gives us ~5 MB of base
# vs ~80 MB for debian-slim. Final image lands ~6× smaller. Operator
# can still `docker exec` for debugging because alpine ships busybox.
# musl's default thread stack (128 KB) and malloc are mitigated in
# the binary itself — see crates/runner-binary/src/main.rs.

# ---- builder ----
# rust:N.M-alpine builds against musl by default — output binary is
# fully static, no glibc dependency. musl-dev provides libc headers
# any cc-rs-based dep (mimalloc-sys) needs.
FROM rust:1.90-alpine AS builder
WORKDIR /build

RUN apk add --no-cache musl-dev

# Cache the dependency graph: copy manifests first, then sources.
# Workspace `Cargo.toml` references many crates we don't need at
# runtime (server, cli, etc.), so we copy the whole tree but only
# build the runner-binary target.
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY plugins ./plugins

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --bin execlaw-runner --no-default-features \
    && cp target/release/execlaw-runner /tmp/execlaw-runner

# ---- runtime ----
# Bare alpine + ca-certificates. ca-certificates lets rustls-native-certs
# load the system trust store at startup, which matters when operators
# install their own CA (e.g. terminating TLS at the inference proxy
# with a self-signed cert).
FROM alpine:3.20
RUN apk add --no-cache ca-certificates

# Workspace mount point. Supervisor mounts the per-group named
# volume here; the runner has full RW within /workspace and zero
# access elsewhere on the FS.
RUN mkdir -p /workspace
WORKDIR /workspace

COPY --from=builder /tmp/execlaw-runner /usr/local/bin/execlaw-runner

# Drop privileges. UID/GID 1000 keeps any files written to /workspace
# owned by a non-root user (matters when the operator inspects the
# volume from the host).
RUN adduser -D -u 1000 -h /home/runner -s /sbin/nologin runner \
    && chown -R runner:runner /workspace
USER runner

ENTRYPOINT ["/usr/local/bin/execlaw-runner"]
