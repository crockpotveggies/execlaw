# EditorConfig — cross-IDE convention for indentation, line endings,
# and trailing whitespace. https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Markdown's two-space-trailing for soft breaks would be eaten by the
# global rule otherwise. Keep them.
trim_trailing_whitespace = false

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.{js,mjs,ts,tsx,jsx,css,scss,html}]
indent_size = 4

[Makefile]
indent_style = tab
