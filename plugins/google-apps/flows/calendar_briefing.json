{
  "trigger": { "kind": "calendar.event.starting_soon", "when": null },
  "nodes": [
    {
      "id": "brief",
      "kind": "AskAgent",
      "config": {
        "prompt": "Generate a brief 2-3 sentence pre-meeting summary for an upcoming calendar event. Event details: {{event.payload}}",
        "attachments": [],
        "exit_tools": [
          {
            "name": "deliver_brief",
            "description": "Deliver the meeting brief to the operator's Inbox.",
            "args_schema": {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              },
              "required": ["text"]
            }
          }
        ]
      }
    },
    {
      "id": "notify",
      "kind": "Notify",
      "config": {
        "title": "Meeting briefing",
        "detail": "{{brief.args.text}}",
        "severity": "Info"
      }
    }
  ],
  "edges": [
    { "from": "trigger", "to": "brief", "when": null },
    { "from": "brief", "to": "notify", "when": null },
    { "from": "notify", "to": "END", "when": null }
  ]
}
