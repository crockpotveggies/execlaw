{
    "type": "object",
    "properties": {
        "title": {
            "type": "string",
            "description": "Chart title — rendered at the top of the SVG/PNG and used as the figcaption in the SPA chat card."
        },
        "kind": {
            "type": "string",
            "enum": ["line", "bar", "area", "scatter"],
            "description": "Default \"line\"."
        },
        "x_label": { "type": "string" },
        "y_label": { "type": "string" },
        "y_unit": {
            "type": "string",
            "description": "Suffix appended to y-axis tick labels (e.g. \"°C\", \" mm\")."
        },
        "time_axis": {
            "type": "boolean",
            "description": "When true, x-values are interpreted as Unix-milliseconds and the axis renders as HH:MM / MMM-DD. When false they're plain ordinals (hour index, day index, etc.)."
        },
        "series": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "points": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "x": { "type": "number" },
                                "y": { "type": "number" }
                            },
                            "required": ["x", "y"]
                        }
                    },
                    "color": {
                        "type": "array",
                        "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                        "minItems": 3,
                        "maxItems": 3,
                        "description": "Optional RGB triple [r,g,b]. Defaults to a colorblind-safe palette by series index."
                    }
                },
                "required": ["name", "points"]
            }
        },
        "band": {
            "type": "object",
            "description": "Optional probability / range overlay (ensemble fans).",
            "properties": {
                "low": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" }
                        },
                        "required": ["x", "y"]
                    }
                },
                "high": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" }
                        },
                        "required": ["x", "y"]
                    }
                },
                "color": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 },
                    "minItems": 3,
                    "maxItems": 3
                }
            },
            "required": ["low", "high"]
        },
        "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 2400,
            "description": "Canvas width in pixels. Default 720."
        },
        "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 2400,
            "description": "Canvas height in pixels. Default 400."
        },
        "filename": {
            "type": "string",
            "description": "Filename for the PNG attachment (operator's save-as dialog). Default \"chart.png\"."
        },
        "ttl_seconds": {
            "type": "integer",
            "minimum": 0,
            "description": "How long the PNG artifact lives before the ephemeral sweeper removes it. 0 = no TTL. Default 604800 (7 days)."
        }
    },
    "additionalProperties": false
}
