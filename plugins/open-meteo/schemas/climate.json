{
    "type": "object",
    "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "place_name": { "type": "string" },
        "start_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date — CMIP6 projections span 1950..2050."
        },
        "end_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "models": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Climate models to query. Examples: \"CMCC_CM2_VHR4\", \"EC_Earth3P_HR\", \"FGOALS_f3_H\", \"HiRAM_SIT_HR\", \"MPI_ESM1_2_XR\", \"NICAM16_8S\". At least one required."
        },
        "daily": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Daily variables. Common: temperature_2m_mean, temperature_2m_max, temperature_2m_min, precipitation_sum, wind_speed_10m_mean, relative_humidity_2m_mean."
        },
        "temperature_unit": {
            "type": "string",
            "enum": ["celsius", "fahrenheit"]
        },
        "wind_speed_unit": {
            "type": "string",
            "enum": ["kmh", "ms", "mph", "kn"]
        }
    },
    "required": ["start_date", "end_date", "models"],
    "additionalProperties": false
}
