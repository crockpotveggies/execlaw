{
    "type": "object",
    "properties": {
        "query": {
            "type": "string",
            "description": "Natural-language place query, e.g. \"coffee near Gastown\" or \"24-hour ramen Vancouver\"."
        },
        "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum places to return (1-20, default 5)."
        },
        "min_rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5,
            "description": "Optional client-side rating filter (0-5)."
        },
        "open_now": {
            "type": "boolean",
            "description": "Only return places currently open."
        },
        "type": {
            "type": "string",
            "description": "Optional Google place type — see https://developers.google.com/maps/documentation/places/web-service/place-types (e.g. `restaurant`, `cafe`, `lodging`)."
        }
    },
    "required": ["query"],
    "additionalProperties": false
}
