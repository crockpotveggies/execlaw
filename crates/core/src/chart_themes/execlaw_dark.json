    },
    "header": {
      "labelColor": "#e6edf3",
      "titleColor": "#e6edf3"
    },
    "range": {
      "category": [
        "#4493f8",
        "#3fb950",
        "#d29922",
        "#f85149",
        "#58a6ff",
        "#a371f7",
        "#ff8a38",
        "#7d8590"
