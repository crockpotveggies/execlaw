      "fontWeight": 600
    },
    "view": {
      "stroke": "transparent"
    },
    "axis": {
      "domainColor": "#30363d",
      "tickColor": "#30363d",
      "gridColor": "#1f2630",
      "labelColor": "#7d8590",
      "titleColor": "#e6edf3",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelColor": "#e6edf3",
